doctype html 
html
    head
        title= "Dark Chat Bot"
        script(src='/chat.js')
        script(src='/socket.io/socket.io.js')
        style.
            * {
                margin: 2px; padding: 2px; box-sizing: border-box;
                font-family: 'Inter', sans-serif;
            }
            body {
                background:#e86868; color: #ddd;
                display: flex; flex-direction: column;
                align-items: center; justify-content: center;
                height: 100vh; padding: 15px;
            }
            #chat-container {
                width: 480px;
                background: #1a1a1a;
                border-radius: 8px;
                padding: 15px;
                box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
            }
            #content {
                width: 100%; height: 300px;
                border-radius: 6px;
                background: #222;
                padding: 10px;
                overflow-y: auto;
                border: 1px solid #333;
                box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.05);
                font-size: 14px;
            }
            .controls {
                display: flex; flex-direction: column;
                gap: 10px; margin-top: 10px;
            }
            input {
                width: 100%; padding: 10px;
                border: 1px solid #333;
                border-radius: 4px;
                background: #222;
                color: #ddd; font-size: 14px;
                transition: 0.2s;
            }
            input:focus {
                border-color: #007bff;
                box-shadow: 0 0 5px #007bff;
                outline: none;
            }
            #send {
                cursor:black;
                background: greenyellow;
                color: white;
                border: none;
                padding: 12px;
                font-size: 14px;
                font-weight: 600;
                border-radius: 4px;
                transition: 0.2s;
            }
            #send:hover { background: #0056b3; }
            #send:active { background: #004080; }
    body
        #chat-container
            #content
            .controls
                input#name(placeholder="Your Name")
                input#field(placeholder="Type a message...")
                input#send(type='button', value='Send')
